---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apps } from "../lib/apps";
---

<BaseLayout title="ساختنیه؟">

  <section style="padding:40px;font-family:sans-serif">

    <h1>
      ساختنیه؟
    </h1>

    <p>
      بررسی می‌کنیم کدام ابزارها را می‌شود با AI ساخت.
    </p>


    <h2>
      ابزارها
    </h2>


    <ul>
      {
        apps.map((app) => (
          <li>
            <a href={`/tools/${app.slug}`}>
              {app.name.fa}
            </a>
          </li>
        ))
      }
    </ul>

  </section>

</BaseLayout>
