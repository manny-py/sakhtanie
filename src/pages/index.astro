---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroTerminal from "../components/HeroTerminal.astro";
import SearchBox from "../components/SearchBox.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import FeaturedTools from "../components/FeaturedTools.astro";
import AnalyticsSummary from "../components/AnalyticsSummary.astro";
---

<BaseLayout
  title="ساختنیه؟ | بررسی ابزارهایی که می‌شود با AI ساخت"
  description="ساختنیه بررسی می‌کند ساخت نسخه مشابه ابزارهای هوش مصنوعی، بهره‌وری، طراحی وب و اتوماسیون از نظر فنی، زمان، هزینه و ارزش محصول چقدر منطقی است."
>
  <Header />

  <main tabindex="-1" id="main-content" class="container home-main">
    <HeroTerminal />
    <SearchBox />
    <AnalyticsSummary />
    <CategoryGrid />
    <FeaturedTools />
  </main>

  <Footer />
</BaseLayout>

<style>
  .home-main {
    min-height: 100vh;
  }
</style>
