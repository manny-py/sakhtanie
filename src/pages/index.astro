---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/layout/PageShell.astro";
import HeroTerminal from "../components/HeroTerminal.astro";
import SearchBox from "../components/SearchBox.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import CatalogProgress from "../components/CatalogProgress.astro";
import NewToolsSection from "../components/NewToolsSection.astro";
import FeaturedTools from "../components/FeaturedTools.astro";
import AnalyticsSummary from "../components/AnalyticsSummary.astro";
import SponsorSlot from "../components/SponsorSlot.astro";
import HomeDiscovery from "../components/HomeDiscovery.astro";
import {
  homepagePrimarySponsor,
  homepageSecondarySponsor,
} from "../lib/sponsors";
---

<BaseLayout
  title="ساختنیه؟ | بررسی ابزارهایی که می‌شود با AI ساخت"
  description="ساختنیه بررسی می‌کند ساخت نسخه مشابه ابزارهای هوش مصنوعی، بهره‌وری، طراحی وب و اتوماسیون از نظر فنی، زمان، هزینه و ارزش محصول چقدر منطقی است."
>
  <PageShell class="container home-main">
    <HeroTerminal />

    <SearchBox />

    <SponsorSlot
      sponsor={homepagePrimarySponsor}
      variant="primary"
    />

    <CategoryGrid />

    <CatalogProgress />

    <NewToolsSection />

    <FeaturedTools />

    <AnalyticsSummary />

    <SponsorSlot
      sponsor={homepageSecondarySponsor}
      variant="secondary"
    />

    <HomeDiscovery />
  </PageShell>
</BaseLayout>

<style>
  .home-main {
    min-height: 100vh;
  }
</style>
