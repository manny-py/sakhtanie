---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroTerminal from "../components/HeroTerminal.astro";
import SearchBox from "../components/SearchBox.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import FeaturedTools from "../components/FeaturedTools.astro";
---

<BaseLayout
  title="ساختنیه؟ | بررسی ابزارهایی که می‌شود با AI ساخت"
  description="بررسی می‌کنیم ساخت نسخه مشابه ابزارهای مختلف چقدر منطقی و عملی است."
>
  <Header />

  <main class="container home-main">
    <HeroTerminal />
    <SearchBox />
    <CategoryGrid />
    <FeaturedTools />
  </main>

  <Footer />
</BaseLayout>

<style>
  .home-main {
    min-height: 100vh;
  }
</style>
