---
import PageShell from "../../components/layout/PageShell.astro";
import AnalysisSection from "../../components/sakhtanie/AnalysisSection.astro";
import Comparison from "../../components/sakhtanie/Comparison.astro";
import CostBreakdown from "../../components/sakhtanie/CostBreakdown.astro";
import FaqList from "../../components/sakhtanie/FaqList.astro";
import PromptBlock from "../../components/sakhtanie/PromptBlock.astro";
import ProductFit from "../../components/sakhtanie/ProductFit.astro";
import RelatedTools from "../../components/sakhtanie/RelatedTools.astro";
import ScoreDetails from "../../components/sakhtanie/ScoreDetails.astro";
import SkillMatrix from "../../components/sakhtanie/SkillMatrix.astro";
import ToolBreadcrumbs from "../../components/sakhtanie/ToolBreadcrumbs.astro";
import ToolHero from "../../components/sakhtanie/ToolHero.astro";
import ToolSidebar from "../../components/sakhtanie/ToolSidebar.astro";
import VerdictBlock from "../../components/sakhtanie/VerdictBlock.astro";
import Card from "../../components/ui/Card.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apps } from "../../lib/apps";
import { categoryDefinitions } from "../../lib/categories";
import { toVerdictState } from "../../lib/verdict-adapter";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: {
      slug: app.slug,
    },
    props: {
      app,
    },
  }));
}

const { app } = Astro.props;

const categoryLabels = Object.fromEntries(
  categoryDefinitions.map((category) => [
    category.slug,
    category.shortTitle,
  ])
) as Record<string, string>;

const categoryLabel =
  categoryLabels[app.category] ?? app.category;

const verdictState = toVerdictState(app.verdict.value);

const relatedTools = (app.relatedTools ?? []).flatMap(
  (slug: string) => {
    const related = apps.find((item) => item.slug === slug);
    return related ? [related] : [];
  }
);

const faqItems = app.seo?.faq ?? [];

const tocItems = [
  { href: "#verdict", label: "جواب کوتاه" },
  { href: "#comparison", label: "نسخه قابل ساخت" },
  { href: "#build", label: "مسیر ساخت" },
  { href: "#prompt", label: "Prompt اولیه" },
  { href: "#scores", label: "امتیازها" },
  ...(faqItems.length > 0
    ? [{ href: "#faq", label: "سوالات متداول" }]
    : []),
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: app.name.en,
  alternateName: app.name.fa,
  description: app.summary,
  applicationCategory:
    categoryLabels[app.category] ?? app.category,
  url: `https://sakhtanie.ir/tools/${app.slug}`,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(
    (item: { question: string; answer: string }) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })
  ),
};
---

<BaseLayout
  title={`آیا می‌شه ${app.name.en} ساخت؟ | ساختنیه؟`}
  description={app.summary}
>
  <PageShell>
    <div
      class="tool-page"
      data-tool-slug={app.slug}
    >
    <ToolBreadcrumbs
      categoryHref={`/categories/${app.category}`}
      categoryLabel={categoryLabel}
      toolName={app.name.en}
    />

    <ToolHero
      app={app}
      categoryLabel={categoryLabel}
      verdictState={verdictState}
    />

    <section class="tool-layout">
      <article class="tool-content">
        <VerdictBlock
          id="verdict"
          verdict={verdictState}
          title={app.verdict.short}
          description={app.verdict.reason}
        />

        <Comparison id="comparison" app={app} />

        <AnalysisSection
          id="build"
          eyebrow="BUILD PLAN"
          title="مسیر ساخت"
        >
          <Card>
            <p class="build-rationale__label">CORE LOOP</p>
            <p class="build-rationale__copy">{app.build.coreLoop}</p>
          </Card>
        </AnalysisSection>

        <SkillMatrix app={app} />

        {
          app.build.limitations.length > 0 && (
            <AnalysisSection title="محدودیت‌های نسخه قابل ساخت">
              <Card>
                <ul class="build-limitations">
                  {app.build.limitations.map(
                    (item: string) => (
                      <li>{item}</li>
                    )
                  )}
                </ul>
              </Card>
            </AnalysisSection>
          )
        }

        <CostBreakdown app={app} />

        <PromptBlock id="prompt" prompt={app.build.prompt} />

        <ScoreDetails id="scores" app={app} />

        <ProductFit app={app} />

        <FaqList id="faq" items={faqItems} />

        <RelatedTools tools={relatedTools} compact />
      </article>

      <ToolSidebar
        items={tocItems}
        tags={app.tags}
        externalUrl={`https://${app.domain}`}
      />
    </section>
    </div>
  </PageShell>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />

  {
    faqItems.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )
  }
</BaseLayout>

<script>
  import { track } from "../../lib/analytics";

  const toolPage =
    document.querySelector<HTMLElement>("[data-tool-slug]");

  const toolSlug = toolPage?.dataset.toolSlug;

  if (toolSlug) {
    track("tool_view", {
      tool_slug: toolSlug,
    });
  }

  document.addEventListener(
    "click",
    (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }

      const externalCta =
        event.target.closest<HTMLAnchorElement>(
          "[data-tool-cta]"
        );

      if (externalCta && toolSlug) {
        track("tool_cta_click", {
          tool_slug: toolSlug,
        });

        return;
      }

      const relatedLink =
        event.target.closest<HTMLAnchorElement>(
          "[data-related-tool]"
        );

      if (relatedLink && toolSlug) {
        const relatedSlug =
          relatedLink.dataset.relatedTool;

        if (!relatedSlug) {
          return;
        }

        track("related_tool_click", {
          tool_slug: toolSlug,
          related_tool_slug: relatedSlug,
        });
      }
    },
    {
      capture: true,
    }
  );
</script>


<style>
  .tool-page {
    width: min(
      1120px,
      calc(100% - (var(--space-6) + var(--space-2)))
    );
    min-height: 100vh;
    margin: 0 auto;
  }

  .tool-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    align-items: start;
    gap: var(--layout-gap);
    padding-bottom: calc(var(--space-8) + var(--space-4));
  }

  .tool-content {
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  .build-rationale__label {
    margin: 0;
    color: var(--color-brand-primary);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-label);
    line-height: var(--line-height-label);
  }

  .build-rationale__copy {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    overflow-wrap: anywhere;
  }

  .build-limitations {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-inline-start: var(--space-5);
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    line-height: var(--line-height-body);
  }

  @media (max-width: 860px) {
    .tool-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .tool-page {
      width: min(
        calc(100% - (var(--space-5) + var(--space-1))),
        1120px
      );
    }
  }
</style>
