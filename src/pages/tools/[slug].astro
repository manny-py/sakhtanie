---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerdictBadge from "../../components/VerdictBadge.astro";
import { apps } from "../../lib/apps";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: {
      slug: app.slug,
    },
    props: {
      app,
    },
  }));
}

const { app } = Astro.props;

const verdict = app.verdict.value;


const softwareSchema = {
  "@context":"https://schema.org",
  "@type":"SoftwareApplication",
  "name":app.name.en,
  "applicationCategory":app.category,
  "description":app.summary
};


---

<BaseLayout
title={`آیا می‌شه ${app.name.fa} ساخت؟ | ساختنیه؟`}
description={app.verdict.short}
/>

<main class="container">

<article style="padding:40px 0">

<h1>
{app.name.fa} ({app.name.en})
</h1>

<VerdictBadge verdict={verdict}/>

<p>
{app.summary}
</p>


<section class="card">
<h2>چرا این نتیجه؟</h2>
<p>{app.verdict.reason}</p>
</section>


<section class="card">
<h2>نسخه‌ای که می‌سازیم</h2>
<p>{app.build.coreLoop}</p>
</section>


<section class="card">
<h2>اطلاعات ساخت</h2>

<p>
زمان:
{app.build.timeEstimate}
</p>

<p>
سطح:
{app.build.skillLevel}
</p>

</section>


<section class="card">
<h2>چی لازم داری؟</h2>

<ul>
{
app.build.requirements.map(item => (
<li>{item.label}</li>
))
}
</ul>

</section>


<section class="card">
<h2>چه چیزهایی رو از دست می‌دی؟</h2>

<ul>
{
app.build.limitations.map(item => (
<li>{item}</li>
))
}
</ul>

</section>


<section class="card">
<h2>پرامپت ساخت</h2>

<pre>
{app.build.prompt.content}
</pre>

</section>


</article>

</main>


<script type="application/ld+json">
{JSON.stringify(softwareSchema)}
</script>

</BaseLayout>

