---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import VerdictBadge from "../../components/VerdictBadge.astro";
import { apps } from "../../lib/apps";


export async function getStaticPaths() {

const appsList = apps;

return appsList.map((app:any)=>({

params:{
slug:app.slug
},

props:{
app
}

}));

}


const { app } = Astro.props;

const softwareSchema = {

"@context":"https://schema.org",

"@type":"SoftwareApplication",

"name":app.name.en,

"description":app.summary

};

---

<BaseLayout
title={`آیا می‌شه ${app.name.fa} ساخت؟ | ساختنیه؟`}
description={app.summary}
>

<Header />


<main class="container">


<section style="padding:40px 0">


<h1>
آیا می‌شه {app.name.fa} ساخت؟
</h1>


<p>
{app.summary}
</p>



<VerdictBadge verdict={app.verdict.value}/>


<h2>
جواب کوتاه
</h2>

<p>
{app.verdict.short}
</p>


<h2>
چرا؟
</h2>

<p>
{app.verdict.reason}
</p>



<h2>
نسخه‌ای که می‌شود ساخت
</h2>

<p>
{app.comparison.buildableVersion}
</p>


<h2>
چه چیزهایی سخت هستند؟
</h2>

<ul>

{
app.comparison.missing.map((item:string)=>(
<li>{item}</li>
))
}

</ul>



<h2>
چه کسانی باید این ابزار را بسازند؟
</h2>


<ul>

{
app.audience.map((item:string)=>(
<li>{item}</li>
))
}

</ul>



<h2>
مدل درآمدی احتمالی
</h2>


<ul>

{
app.monetization.models.map((item:string)=>(
<li>{item}</li>
))
}

</ul>



<h2>
نیازمندی‌های ساخت
</h2>


<ul>

{
app.build.requirements.map((item:any)=>(
<li>{item.label}</li>
))
}

</ul>



<h2>
محدودیت‌ها
</h2>


<ul>

{
app.build.limitations.map((item:string)=>(
<li>{item}</li>
))
}

</ul>



<h2>
امتیاز ساخت
</h2>


<ul>

<li>
پیچیدگی فنی:
{app.scores.technicalComplexity}/5
</li>

<li>
ارزش اقتصادی:
{app.scores.economicValue}/5
</li>

<li>
ریسک ایران:
{app.scores.iranRisk}/5
</li>

</ul>



<h2>
Prompt اولیه ساخت
</h2>


<pre>
{app.build.prompt.content}
</pre>



</section>


</main>


<Footer />



<script type="application/ld+json">
{JSON.stringify(softwareSchema)}
</script>


</BaseLayout>
