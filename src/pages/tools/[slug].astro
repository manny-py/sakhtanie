---
import AppLogo from "../../components/AppLogo.astro";
import PageShell from "../../components/layout/PageShell.astro";
import AnalysisSection from "../../components/sakhtanie/AnalysisSection.astro";
import BuildScore from "../../components/sakhtanie/BuildScore.astro";
import Comparison from "../../components/sakhtanie/Comparison.astro";
import CostBreakdown from "../../components/sakhtanie/CostBreakdown.astro";
import PromptBlock from "../../components/sakhtanie/PromptBlock.astro";
import RelatedTools from "../../components/sakhtanie/RelatedTools.astro";
import SkillMatrix from "../../components/sakhtanie/SkillMatrix.astro";
import VerdictBadge from "../../components/sakhtanie/VerdictBadge.astro";
import VerdictBlock from "../../components/sakhtanie/VerdictBlock.astro";
import Card from "../../components/ui/Card.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apps } from "../../lib/apps";
import { categoryDefinitions } from "../../lib/categories";
import { toVerdictState } from "../../lib/verdict-adapter";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: {
      slug: app.slug,
    },
    props: {
      app,
    },
  }));
}

const { app } = Astro.props;

const categoryLabels = Object.fromEntries(
  categoryDefinitions.map((category) => [
    category.slug,
    category.shortTitle,
  ])
) as Record<string, string>;

const monetizationLabels: Record<string, string> = {
  subscription: "اشتراک",
  service: "فروش خدمات",
  commission: "کمیسیون",
  advertising: "تبلیغات",
  freemium: "فریمیوم",
  marketplace: "مارکت‌پلیس",
  licensing: "لایسنس",
  "one-time-payment": "پرداخت یک‌باره",
};

const verdictState = toVerdictState(app.verdict.value);

const relatedTools = (app.relatedTools ?? []).flatMap(
  (slug: string) => {
    const related = apps.find((item) => item.slug === slug);
    return related ? [related] : [];
  }
);

const faqItems = app.seo?.faq ?? [];

const scoreEntries = [
  {
    label: "پیچیدگی فنی",
    value: app.scores.technicalComplexity,
  },
  {
    label: "وابستگی خارجی",
    value: app.scores.externalDependency,
  },
  {
    label: "نیاز به داده اختصاصی",
    value: app.scores.proprietaryData,
  },
  {
    label: "نیاز زیرساختی",
    value: app.scores.infrastructure,
  },
  {
    label: "هزینه ساخت",
    value: app.scores.buildCost,
  },
  {
    label: "هزینه نگهداری",
    value: app.scores.maintenanceCost,
  },
  {
    label: "ارزش شخصی",
    value: app.scores.personalValue,
  },
  {
    label: "ارزش اقتصادی",
    value: app.scores.economicValue,
  },
  {
    label: "ریسک ایران",
    value: app.scores.iranRisk,
  },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: app.name.en,
  alternateName: app.name.fa,
  description: app.summary,
  applicationCategory:
    categoryLabels[app.category] ?? app.category,
  url: `https://sakhtanie.ir/tools/${app.slug}`,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(
    (item: { question: string; answer: string }) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })
  ),
};
---

<BaseLayout
  title={`آیا می‌شه ${app.name.en} ساخت؟ | ساختنیه؟`}
  description={app.summary}
>
  <PageShell>
    <div
      class="tool-page"
      data-tool-slug={app.slug}
    >
    <div class="tool-breadcrumb">
      <a href="/">ساختنیه؟</a>
      <span>/</span>

      <a href={`/categories/${app.category}`}>
        {categoryLabels[app.category] ?? app.category}
      </a>

      <span>/</span>
      <strong dir="ltr">{app.name.en}</strong>
    </div>

    <section class="tool-hero">
      <div class="tool-hero__main">
        <div class="tool-identity">
          <span
            class="tool-icon"
            dir="ltr"
            aria-hidden="true"
          >
        <AppLogo app={app} />
      </span>

          <div>
            <span class="tool-domain" dir="ltr">
              {app.domain}
            </span>

            <h1>
              آیا می‌شه
              <bdi class="tool-name" dir="ltr">
                {app.name.en}
              </bdi>
              ساخت؟
            </h1>
          </div>
        </div>

        <p class="tool-summary">{app.summary}</p>

        <div class="tool-meta">
          <span>
            دسته:
            <strong>
              {categoryLabels[app.category] ?? app.category}
            </strong>
          </span>
        </div>

        <div class="hero-build-score">
          <BuildScore app={app} compact />
        </div>
      </div>

      <aside class="hero-verdict" aria-label="نتیجه نهایی">
        <VerdictBadge verdict={verdictState} />
        <p>{app.verdict.short}</p>
      </aside>
    </section>

    <section class="tool-layout">
      <article class="tool-content">
        <VerdictBlock
          id="verdict"
          verdict={verdictState}
          title={app.verdict.short}
          description={app.verdict.reason}
        />

        <Comparison id="comparison" app={app} />

        <AnalysisSection
          id="build"
          eyebrow="BUILD PLAN"
          title="مسیر ساخت"
        >
          <Card>
            <p class="build-rationale__label">CORE LOOP</p>
            <p class="build-rationale__copy">{app.build.coreLoop}</p>
          </Card>
        </AnalysisSection>

        <SkillMatrix app={app} />

        {
          app.build.limitations.length > 0 && (
            <AnalysisSection title="محدودیت‌های نسخه قابل ساخت">
              <Card>
                <ul class="build-limitations">
                  {app.build.limitations.map(
                    (item: string) => (
                      <li>{item}</li>
                    )
                  )}
                </ul>
              </Card>
            </AnalysisSection>
          )
        }

        <CostBreakdown app={app} />

        <PromptBlock id="prompt" prompt={app.build.prompt} />

        <section id="scores" class="content-panel">
          <span class="panel-kicker">SCORES</span>
          <h2>امتیازهای ساخت</h2>

          <div class="scores-grid">
            {
              scoreEntries.map((score) => (
                <div
                  class="score-row"
                  style={`--score: ${score.value}`}
                >
                  <div>
                    <span>{score.label}</span>

                    <strong dir="ltr">
                      {score.value}/5
                    </strong>
                  </div>

                  <div class="score-track">
                    <span></span>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section class="content-panel">
          <span class="panel-kicker">PRODUCT FIT</span>
          <h2>برای چه کسانی و با چه مدل درآمدی؟</h2>

          <div class="fit-grid">
            <div>
              <h3>مخاطبان مناسب</h3>

              <div class="tag-list">
                {
                  app.audience.map((item: string) => (
                    <span>{item}</span>
                  ))
                }
              </div>
            </div>

            <div>
              <h3>مدل‌های درآمدی</h3>

              {
                app.monetization.possible ? (
                  <div class="tag-list">
                    {app.monetization.models.map(
                      (item: string) => (
                        <span>
                          {monetizationLabels[item] ?? item}
                        </span>
                      )
                    )}
                  </div>
                ) : (
                  <p class="muted-copy">
                    مدل درآمدی مشخصی برای این نسخه ثبت نشده است.
                  </p>
                )
              }
            </div>
          </div>
        </section>

        {
          faqItems.length > 0 && (
            <section id="faq" class="content-panel">
              <span class="panel-kicker">FAQ</span>
              <h2>سوالات متداول</h2>

              <div class="faq-list">
                {faqItems.map(
                  (
                    item: {
                      question: string;
                      answer: string;
                    },
                    index: number
                  ) => (
                    <details open={index === 0}>
                      <summary>{item.question}</summary>
                      <p>{item.answer}</p>
                    </details>
                  )
                )}
              </div>
            </section>
          )
        }

        <RelatedTools tools={relatedTools} compact />
      </article>

      <aside class="tool-sidebar">
        <nav class="sidebar-panel">
          <span>ON THIS PAGE</span>

          <a href="#verdict">جواب کوتاه</a>
          <a href="#comparison">نسخه قابل ساخت</a>
          <a href="#build">مسیر ساخت</a>
          <a href="#prompt">Prompt اولیه</a>
          <a href="#scores">امتیازها</a>

          {
            faqItems.length > 0 && (
              <a href="#faq">سوالات متداول</a>
            )
          }
        </nav>

        <div class="sidebar-panel">
          <span>TAGS</span>

          <div class="sidebar-tags">
            {
              app.tags.map((tag: string) => (
                <small>{tag}</small>
              ))
            }
          </div>
        </div>

        <a
          class="external-link"
          data-tool-cta
          href={`https://${app.domain}`}
          target="_blank"
          rel="noreferrer"
        >
          مشاهده وب‌سایت اصلی
          <span dir="ltr">↗</span>
        </a>
      </aside>
    </section>
    </div>
  </PageShell>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />

  {
    faqItems.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )
  }
</BaseLayout>

<script>
  import { track } from "../../lib/analytics";

  const toolPage =
    document.querySelector<HTMLElement>("[data-tool-slug]");

  const toolSlug = toolPage?.dataset.toolSlug;

  if (toolSlug) {
    track("tool_view", {
      tool_slug: toolSlug,
    });
  }

  document.addEventListener(
    "click",
    (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }

      const externalCta =
        event.target.closest<HTMLAnchorElement>(
          "[data-tool-cta]"
        );

      if (externalCta && toolSlug) {
        track("tool_cta_click", {
          tool_slug: toolSlug,
        });

        return;
      }

      const relatedLink =
        event.target.closest<HTMLAnchorElement>(
          "[data-related-tool]"
        );

      if (relatedLink && toolSlug) {
        const relatedSlug =
          relatedLink.dataset.relatedTool;

        if (!relatedSlug) {
          return;
        }

        track("related_tool_click", {
          tool_slug: toolSlug,
          related_tool_slug: relatedSlug,
        });
      }
    },
    {
      capture: true,
    }
  );
</script>


<style>
  .tool-page {
    width: min(1120px, calc(100% - 40px));
    min-height: 100vh;
    margin: 0 auto;
  }

  .tool-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 46px;
    color: #69736b;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .tool-breadcrumb a:hover {
    color: #22e863;
  }

  .tool-breadcrumb strong {
    color: #22e863;
    font-weight: 500;
  }

  .tool-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 285px;
    align-items: stretch;
    gap: 26px;
    padding: 38px 0 48px;
  }

  .tool-hero__main {
    min-width: 0;
  }

  .tool-identity {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
  }

  .tool-icon {
    width: 62px;
    height: 62px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 8px;
    border: 1px solid #2b392e;
    box-sizing: border-box;
    border-radius: 15px;
    background: #172019;
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
    font-size: 23px;
    font-weight: 800;
  }

  .tool-domain {
    display: block;
    margin-bottom: 8px;
    color: #6f7971;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .tool-identity h1 {
    margin: 0;
    color: #f5f5f4;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.35;
  }

  .tool-identity h1 span {
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
  }

  .tool-summary {
    max-width: 760px;
    margin: 26px 0 0;
    color: #929c94;
    font-size: 15px;
    line-height: 2;
  }

  .tool-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 26px;
  }

  .tool-meta > span {
    padding: 7px 10px;
    border: 1px solid #253027;
    border-radius: 8px;
    background: #0e120f;
    color: #778179;
    font-size: 10px;
  }

  .tool-meta strong {
    margin-right: 4px;
    color: #c8d0ca;
    font-weight: 500;
  }

  .hero-build-score {
    min-width: 0;
    margin-top: var(--space-5);
  }

  .hero-verdict {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .hero-verdict p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .tool-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    align-items: start;
    gap: 24px;
    padding-bottom: 80px;
  }

  .tool-content {
    min-width: 0;
    display: grid;
    gap: 16px;
  }

  .content-panel,
  .sidebar-panel {
    border: 1px solid #202a22;
    border-radius: 15px;
    background: #0d110e;
  }

  .content-panel {
    padding: 27px;
  }

  .panel-kicker,
  .sidebar-panel > span {
    color: #687269;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .content-panel h2 {
    margin: 7px 0 20px;
    color: #f4f4f5;
    font-size: 25px;
  }

  .content-panel h3 {
    margin: 25px 0 13px;
    color: #e5e8e6;
    font-size: 16px;
  }

  .build-rationale__label {
    margin: 0;
    color: var(--color-brand-primary);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-label);
    line-height: var(--line-height-label);
  }

  .build-rationale__copy {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    overflow-wrap: anywhere;
  }

  .build-limitations {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-inline-start: var(--space-5);
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    line-height: var(--line-height-body);
  }

  .scores-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px 24px;
  }

  .score-row > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 7px;
    color: #929c94;
    font-size: 10px;
  }

  .score-row strong {
    color: #dfe3e0;
    font-family: "JetBrains Mono", monospace;
    font-weight: 500;
  }

  .score-track {
    height: 7px;
    overflow: hidden;
    border-radius: 999px;
    background: #1c241e;
  }

  .score-track span {
    width: calc(var(--score) * 20%);
    height: 100%;
    display: block;
    border-radius: inherit;
    background: #22e863;
  }

  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .fit-grid > div {
    padding: 18px;
    border: 1px solid #253027;
    border-radius: 12px;
    background: #111612;
  }

  .fit-grid h3 {
    margin-top: 0;
  }

  .tag-list,
  .sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tag-list span,
  .sidebar-tags small {
    padding: 6px 9px;
    border: 1px solid #2a342c;
    border-radius: 7px;
    background: #151b16;
    color: #a8b0aa;
    font-size: 10px;
  }

  .muted-copy {
    color: #879189;
    font-size: 12px;
    line-height: 1.9;
  }

  .faq-list {
    display: grid;
  }

  .faq-list details {
    padding: 17px 0;
    border-top: 1px solid #202a22;
  }

  .faq-list details:first-child {
    border-top: 0;
  }

  .faq-list summary {
    color: #e5e8e6;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .faq-list p {
    margin: 13px 0 0;
    color: #929c94;
    font-size: 13px;
    line-height: 2;
  }

  .tool-sidebar {
    position: sticky;
    top: 84px;
    display: grid;
    gap: 12px;
  }

  .sidebar-panel {
    display: grid;
    gap: 5px;
    padding: 16px;
  }

  .sidebar-panel > span {
    margin-bottom: 8px;
  }

  .sidebar-panel > a {
    padding: 8px 9px;
    border-radius: 7px;
    color: #8f9991;
    font-size: 11px;
  }

  .sidebar-panel > a:hover {
    background: #151b16;
    color: #f4f4f5;
  }

  .external-link {
    min-height: 43px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 13px;
    border: 1px solid rgba(34, 232, 99, 0.35);
    border-radius: 10px;
    background: rgba(34, 232, 99, 0.06);
    color: #22e863;
    font-size: 11px;
  }

  @media (max-width: 860px) {
    .tool-hero {
      grid-template-columns: 1fr;
    }

    .tool-layout {
      grid-template-columns: 1fr;
    }

    .tool-sidebar {
      position: static;
      grid-row: 1;
      grid-template-columns: 1fr 1fr;
    }

    .external-link {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .tool-page {
      width: min(100% - 28px, 1120px);
    }

    .tool-breadcrumb {
      padding-top: 28px;
    }

    .tool-hero {
      padding: 28px 0 32px;
    }

    .tool-identity {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 12px;
    }

    .tool-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      font-size: 18px;
    }

    .tool-identity h1 {
      font-size: 31px;
    }

    .tool-summary {
      margin-top: 20px;
      font-size: 14px;
    }

    .tool-sidebar {
      grid-template-columns: 1fr;
    }

    .content-panel {
      padding: 20px 16px;
    }

    .content-panel h2 {
      font-size: 22px;
    }

    .scores-grid,
    .fit-grid {
      grid-template-columns: 1fr;
    }

  }

  /* SAK-013.4 MOBILE FIX START */

  .tool-name {
    display: inline-block;
    margin-inline: 0.14em;
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
    unicode-bidi: isolate;
  }

  @media (max-width: 860px) {
    /*
     * محتوای اصلی باید قبل از Sidebar نمایش داده شود.
     * منوی پرش داخلی در موبایل فضای زیادی اشغال می‌کرد.
     */
    .tool-sidebar {
      grid-row: auto;
      grid-template-columns: 1fr;
    }

    .tool-sidebar .sidebar-panel:first-child {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .tool-identity h1 {
      display: block;
      font-size: clamp(28px, 8.2vw, 34px);
      line-height: 1.65;
    }

    .tool-name {
      margin-inline: 0.12em;
    }
  }

  /* SAK-013.4 MOBILE FIX END */

</style>
