---
const categories = [
["ai-assistants","دستیارهای AI"],
["productivity","بهره‌وری"],
["development-automation","توسعه و اتوماسیون"],
["website-commerce","وب و تجارت"]
];
---

<section>

<h2>دسته‌بندی‌ها</h2>

<div class="grid">

{
categories.map(([slug,title])=>(
<a class="card" href={`/categories/${slug}`}>
{title}
</a>
))
}

</div>

</section>


<style>
.grid {
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:16px;
}

.card {
background:var(--surface);
border:1px solid var(--border);
padding:24px;
border-radius:var(--radius-md);
}
</style>
