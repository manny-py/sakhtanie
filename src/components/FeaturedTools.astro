---
import { apps } from "../lib/apps";
import { categoryDefinitions } from "../lib/categories";
import AppLogo from "./AppLogo.astro";

const preferredSlugs = [
  "chatgpt",
  "claude",
  "cursor",
  "lovable",
  "bolt",
  "canva",
  "notion",
  "shopify",
];

const categoryLabels = Object.fromEntries(
  categoryDefinitions.map((category) => [
    category.slug,
    category.shortTitle,
  ])
) as Record<string, string>;

const categorySymbols = Object.fromEntries(
  categoryDefinitions.map((category) => [
    category.slug,
    category.symbol,
  ])
) as Record<string, string>;

const timeLabels: Record<string, string> = {
  "few-hours": "چند ساعت",
  "one-day": "یک روز",
  "few-days": "چند روز",
  "one-weekend": "یک آخر هفته",
  "one-week": "یک هفته",
  "few-weeks": "چند هفته",
  "one-month": "یک ماه",
  "few-months": "چند ماه",
};

const verdictLabels: Record<string, string> = {
  yes: "ساختنیه",
  kinda: "ساختنیه، ولی...",
  no: "نمی‌ارزه",
};

const featured = preferredSlugs
  .map((slug) => apps.find((app) => app.slug === slug))
  .filter(
    (app): app is (typeof apps)[number] => Boolean(app)
  );
---

<section class="featured-section">
  <div class="featured-heading">
    <div>
      <span>FEATURED DATABASE</span>
      <h2>ابزارهای منتخب</h2>
    </div>

    <span class="featured-heading__count">
      {featured.length} ابزار
    </span>
  </div>

  <div class="tool-table">
    <div class="tool-table__header">
      <span>ابزار</span>
      <span>دسته</span>
      <span>زمان ساخت</span>
      <span>نتیجه</span>
      <span>پیچیدگی</span>
    </div>

    {
      featured.map((app, index) => (
        <a
          class="tool-row"
          href={`/tools/${app.slug}`}
        >
          <div class="tool-row__main">
            <span class="tool-row__rank" dir="ltr">
              {String(index + 1).padStart(2, "0")}
            </span>

            <span class="tool-row__logo">
              <AppLogo app={app} />
            </span>

            <strong
              class="tool-row__name"
              dir="ltr"
            >
              {app.name.en}
            </strong>
          </div>

          <span class="tool-row__category">
            <span
              class="tool-row__category-symbol"
              dir="ltr"
              aria-hidden="true"
            >
              {categorySymbols[app.category] ?? "·"}
            </span>

            {categoryLabels[app.category] ?? app.category}
          </span>

          <span class="tool-row__time">
            {timeLabels[app.build.timeEstimate] ??
              app.build.timeEstimate}
          </span>

          <span
            class:list={[
              "tool-row__verdict",
              `verdict-${app.verdict.value}`,
            ]}
          >
            {verdictLabels[app.verdict.value] ??
              app.verdict.value}
          </span>

          <span class="tool-row__complexity" dir="ltr">
            {app.scores.technicalComplexity}/5
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .featured-section {
    max-width: 900px;
    padding: 20px 0 80px;
    margin: 0 auto;
  }

  .featured-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .featured-heading > div > span,
  .featured-heading__count {
    color: #6f7971;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .featured-heading h2 {
    margin: 5px 0 0;
    color: #f4f4f5;
    font-size: 23px;
  }

  .tool-table {
    overflow: hidden;
    border: 1px solid #202a22;
    border-radius: 14px;
    background: #0d110e;
  }

  .tool-table__header,
  .tool-row {
    display: grid;
    grid-template-columns:
      minmax(240px, 1.8fr)
      minmax(100px, 1fr)
      minmax(90px, 0.8fr)
      minmax(110px, 0.9fr)
      70px;
    align-items: center;
    gap: 18px;
    padding: 0 18px;
  }

  .tool-table__header {
    min-height: 48px;
    color: #727c74;
    border-bottom: 1px solid #202a22;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .tool-row {
    min-height: 72px;
    transition: background 140ms ease;
  }

  .tool-row + .tool-row {
    border-top: 1px solid #1e2720;
  }

  .tool-row:hover {
    background: #141a15;
  }

  .tool-row__main {
    min-width: 0;
    display: grid;
    grid-template-columns: 30px 32px minmax(0, 1fr);
    align-items: center;
    gap: 13px;
    direction: rtl;
  }

  .tool-row__rank {
    color: #667068;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    text-align: center;
  }

  .tool-row__logo {
    width: 32px;
    height: 32px;
    overflow: hidden;
    padding: 5px;
    border: 1px solid #263028;
    border-radius: 8px;
    background: #182019;
    box-sizing: border-box;
  }

  .tool-row__name {
    min-width: 0;
    overflow: hidden;
    color: #f4f4f5;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
    unicode-bidi: plaintext;
  }

  .tool-row__category,
  .tool-row__time {
    color: #99a29b;
    font-size: 11px;
  }

  .tool-row__category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .tool-row__category-symbol {
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
  }

  .tool-row__verdict {
    width: fit-content;
    padding: 5px 8px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  .verdict-yes {
    color: #22e863;
    background: rgba(34, 232, 99, 0.1);
    border: 1px solid rgba(34, 232, 99, 0.3);
  }

  .verdict-kinda {
    color: #f1c644;
    background: rgba(241, 198, 68, 0.1);
    border: 1px solid rgba(241, 198, 68, 0.3);
  }

  .verdict-no {
    color: #ff6464;
    background: rgba(255, 100, 100, 0.1);
    border: 1px solid rgba(255, 100, 100, 0.3);
  }

  .tool-row__complexity {
    color: #9ca59e;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
  }

  @media (max-width: 760px) {
    .featured-section {
      padding-bottom: 56px;
    }

    .tool-table__header {
      display: none;
    }

    .tool-row {
      min-height: 88px;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px;
      padding: 15px 16px;
    }

    .tool-row__main {
      grid-template-columns: 26px 32px minmax(0, 1fr);
      gap: 10px;
    }

    .tool-row__name {
      font-size: 13px;
    }

    .tool-row__category,
    .tool-row__time,
    .tool-row__complexity {
      display: none;
    }

    .tool-row__verdict {
      justify-self: end;
    }
  }
</style>
