<script>
  import {
    ANALYTICS_ORIGIN,
    isAnalyticsDisabled,
    track,
  } from "../lib/analytics";

  let presenceId: string | undefined;

  function getPresenceId() {
    presenceId ??= crypto.randomUUID();
    return presenceId;
  }

  async function sendHeartbeat() {
    if (
      document.visibilityState !== "visible" ||
      isAnalyticsDisabled()
    ) {
      return;
    }

    try {
      await fetch(`${ANALYTICS_ORIGIN}/v1/heartbeat`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          session_id: getPresenceId(),
        }),
        keepalive: true,
      });
    } catch {
      // Analytics failures must never affect site usage.
    }
  }

  track("page_view", {});
  sendHeartbeat();

  const heartbeatTimer = window.setInterval(sendHeartbeat, 30_000);

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      sendHeartbeat();
    }
  });

  window.addEventListener(
    "pagehide",
    () => {
      window.clearInterval(heartbeatTimer);
      presenceId = undefined;
    },
    { once: true }
  );
</script>
