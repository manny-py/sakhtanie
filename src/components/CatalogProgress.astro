---
import { apps } from "../lib/apps";

const catalogTarget = 300;
const currentCount = apps.length;
const progressPercentage = Math.min(
  100,
  Math.max(0, (currentCount / catalogTarget) * 100)
);
const currentCountFa = currentCount.toLocaleString("fa-IR");
const catalogTargetFa = catalogTarget.toLocaleString("fa-IR");
---

<section class="catalog-progress">
  <div>
    <span>CATALOG TARGET</span>
    <strong dir="ltr">
      {currentCount} / {catalogTarget}
    </strong>
  </div>

  <div
    class="catalog-progress__track"
    role="progressbar"
    aria-label="پیشرفت انتشار تحلیل‌های کاتالوگ ساختنیه"
    aria-valuemin="0"
    aria-valuemax={catalogTarget}
    aria-valuenow={currentCount}
    aria-valuetext={`${currentCountFa} تحلیل از هدف ${catalogTargetFa} تحلیل منتشر شده`}
  >
    <span
      aria-hidden="true"
      style={`width:${progressPercentage}%`}
    ></span>
  </div>

  <p>
    هدف بعدی: انتشار {catalogTargetFa} تحلیل؛ اکنون {currentCountFa} تحلیل
    منتشر شده.
  </p>
</section>

<style>
  .catalog-progress {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    border: 1px solid #202a22;
    border-radius: 12px;
    background: #0d110e;
  }

  .catalog-progress > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .catalog-progress span {
    color: #747e76;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
  }

  .catalog-progress strong {
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
  }

  .catalog-progress__track {
    height: 5px;
    margin-top: 14px;
    overflow: hidden;
    border-radius: 999px;
    background: #182019;
  }

  .catalog-progress__track span {
    height: 100%;
    display: block;
    background: #22e863;
  }

  .catalog-progress p {
    margin: 10px 0 0;
    color: #747e76;
    font-size: 10px;
  }
</style>
