---
import { MONETIZATION_ENABLED } from "../../lib/monetization";
import {
  getGlobalSponsorPlacements,
  globalSponsorInventory,
  resolveGlobalSponsorPlacement,
  type GlobalSponsorInventory,
} from "../../lib/sponsor-placements";
import DesktopSponsorRails from "./DesktopSponsorRails.astro";
import SponsorTrackingClient from "./SponsorTrackingClient.astro";

interface Props {
  inventory?: GlobalSponsorInventory;
}

const { inventory = globalSponsorInventory } = Astro.props;
const desktopSurfaces = ["desktop-left", "desktop-right"] as const;
const hasActiveDesktopPlacement = desktopSurfaces.some((surface) =>
  getGlobalSponsorPlacements(surface, inventory).some(
    (placement) => resolveGlobalSponsorPlacement(placement.id, inventory).active,
  ),
);
---

{
  MONETIZATION_ENABLED && hasActiveDesktopPlacement && (
    <>
      <DesktopSponsorRails inventory={inventory} />
      <SponsorTrackingClient />
    </>
  )
}
