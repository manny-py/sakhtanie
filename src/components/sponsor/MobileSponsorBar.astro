---
import { MONETIZATION_ENABLED } from "../../lib/monetization";
import {
  getGlobalSponsorPlacements,
  globalSponsorInventory,
  resolveGlobalSponsorPlacement,
  type GlobalSponsorInventory,
} from "../../lib/sponsor-placements";
import SponsorBlock from "./SponsorBlock.astro";

type MobileSponsorSurface = "mobile-top" | "mobile-bottom";

interface Props {
  surface: MobileSponsorSurface;
  inventory?: GlobalSponsorInventory;
}

const { surface, inventory = globalSponsorInventory } = Astro.props;
const resolvedPlacements = getGlobalSponsorPlacements(surface, inventory)
  .map((placement) => resolveGlobalSponsorPlacement(placement.id, inventory));
const duplicateSequence = resolvedPlacements;
const positionLabel = surface === "mobile-top" ? "بالای صفحه" : "پایین صفحه";
---

{
  MONETIZATION_ENABLED && (
    <aside
      class="mobile-sponsor-bar"
      aria-label={`تبلیغات ${positionLabel}`}
      data-global-mobile-sponsors={surface}
    >
      <div class="mobile-sponsor-bar__viewport">
        <div class="mobile-sponsor-bar__track">
          <div
            class="mobile-sponsor-bar__sequence"
            data-mobile-sponsor-canonical-sequence
          >
            {resolvedPlacements.map((placement) => (
              <SponsorBlock placement={placement} format="bar" />
            ))}
          </div>

          <div
            class="mobile-sponsor-bar__sequence mobile-sponsor-bar__sequence--duplicate"
            aria-hidden="true"
            data-mobile-sponsor-duplicate-sequence
          >
            {duplicateSequence.map((placement) => (
              <SponsorBlock placement={placement} format="bar" clone />
            ))}
          </div>
        </div>
      </div>
    </aside>
  )
}

<script>
  if (document.querySelector("[data-global-mobile-sponsors]")) {
    document.documentElement.dataset.globalMobileSponsors = "active";
  }
</script>

<style>
  .mobile-sponsor-bar {
    display: none;
    block-size: 42px;
    overflow: hidden;
    border-block: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .mobile-sponsor-bar__viewport {
    block-size: 100%;
    overflow: hidden;
    direction: ltr;
  }

  .mobile-sponsor-bar__track {
    display: flex;
    inline-size: max-content;
    block-size: 100%;
    animation: sponsor-marquee 40s linear infinite;
    will-change: transform;
  }

  .mobile-sponsor-bar:hover .mobile-sponsor-bar__track,
  .mobile-sponsor-bar:focus-within .mobile-sponsor-bar__track {
    animation-play-state: paused;
  }

  .mobile-sponsor-bar__sequence {
    display: flex;
    flex: none;
    block-size: 100%;
    padding-inline-end: var(--space-2);
    align-items: center;
    gap: var(--space-2);
  }

  .mobile-sponsor-bar__filler {
    display: contents;
  }

  @keyframes sponsor-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 767px) {
    .mobile-sponsor-bar {
      display: block;
      position: fixed;
      z-index: 120;
      inset-inline-start: 0;
      inline-size: 100vw;
      max-inline-size: 100vw;
      isolation: isolate;
    }

    .mobile-sponsor-bar[data-global-mobile-sponsors="mobile-top"] {
      inset-block-start: 0;
    }

    .mobile-sponsor-bar[data-global-mobile-sponsors="mobile-bottom"] {
      inset-block-end: 0;
    }

    :global(html[data-global-mobile-sponsors="active"]) {
      scroll-padding-block-start: 122px;
      scroll-padding-block-end: 42px;
      overflow-x: clip;
    }

    :global(html[data-global-mobile-sponsors="active"]) body {
      padding-block-start: 42px;
      padding-block-end: 42px;
      max-inline-size: 100%;
      overflow-x: clip;
    }

    :global(html[data-global-mobile-sponsors="active"] .site-header) {
      top: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-sponsor-bar__viewport {
      overflow-x: auto;
      overscroll-behavior-inline: contain;
    }

    .mobile-sponsor-bar__track {
      animation: none;
      will-change: auto;
    }

    .mobile-sponsor-bar__filler,
    .mobile-sponsor-bar__sequence--duplicate {
      display: none;
    }
  }
</style>
