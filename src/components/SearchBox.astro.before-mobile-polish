---
import { apps } from "../lib/apps";

const categoryLabels: Record<string, string> = {
  "ai-assistants": "دستیار هوش مصنوعی",
  productivity: "بهره‌وری",
  "website-commerce": "وب و کسب‌وکار",
  "development-automation": "توسعه و اتوماسیون",
};

const timeLabels: Record<string, string> = {
  "few-hours": "چند ساعت",
  "one-day": "یک روز",
  "few-days": "چند روز",
  "one-weekend": "یک آخر هفته",
  "one-week": "یک هفته",
  "few-weeks": "چند هفته",
  "one-month": "یک ماه",
  "few-months": "چند ماه",
};

const skillLabels: Record<string, string> = {
  beginner: "مقدماتی",
  intermediate: "متوسط",
  advanced: "پیشرفته",
  expert: "حرفه‌ای",
};

const searchableTools = apps.map((app) => ({
  slug: app.slug,
  fa: app.name.fa,
  en: app.name.en,
  domain: app.domain,
  summary: app.summary,
  category: categoryLabels[app.category] ?? app.category,
  categoryRaw: app.category,
  verdict: app.verdict.value,
  timeEstimate:
    timeLabels[app.build.timeEstimate] ??
    app.build.timeEstimate,
  skillLevel:
    skillLabels[app.build.skillLevel] ??
    app.build.skillLevel,
  complexity: app.scores.technicalComplexity,
  tags: app.tags ?? [],
}));
---

<div
  class="sak-search"
  data-sak-search
  data-tools={JSON.stringify(searchableTools)}
>
  <div
    class="sak-search__box"
    role="combobox"
    aria-expanded="false"
    aria-controls="sak-search-results"
  >
    <span class="sak-search__prompt" aria-hidden="true">
      &gt;
    </span>

    <input
      id="sak-search-input"
      class="sak-search__input"
      type="search"
      placeholder="اسم ابزار را جست‌وجو کن..."
      autocomplete="off"
      spellcheck="false"
      dir="rtl"
      aria-label="جست‌وجوی ابزار"
    />

    <button
      class="sak-search__clear is-hidden"
      type="button"
      aria-label="پاک‌کردن جست‌وجو"
    >
      ×
    </button>

    <kbd class="sak-search__shortcut">⌘ K</kbd>
  </div>

  <div
    id="sak-search-results"
    class="sak-search__results is-hidden"
    role="listbox"
    aria-label="نتایج جست‌وجو"
  ></div>
</div>

<script is:inline>
  const root = document.querySelector("[data-sak-search]");

  if (root instanceof HTMLElement) {
    const input = root.querySelector("#sak-search-input");
    const results = root.querySelector("#sak-search-results");
    const searchBox = root.querySelector(".sak-search__box");
    const clearButton = root.querySelector(".sak-search__clear");
    const shortcut = root.querySelector(".sak-search__shortcut");

    let tools = [];
    let visibleMatches = [];
    let activeIndex = -1;

    try {
      tools = JSON.parse(root.dataset.tools || "[]");
    } catch {
      tools = [];
    }

    const normalize = (value) =>
      String(value ?? "")
        .toLocaleLowerCase("fa")
        .replace(/ي/g, "ی")
        .replace(/ك/g, "ک")
        .replace(/\u200c/g, " ")
        .replace(/[َُِّْٰ]/g, "")
        .replace(/[^\p{L}\p{N}\s-]/gu, " ")
        .replace(/\s+/g, " ")
        .trim();

    const escapeHtml = (value) =>
      String(value ?? "").replace(/[&<>"']/g, (character) => {
        switch (character) {
          case "&":
            return "&amp;";
          case "<":
            return "&lt;";
          case ">":
            return "&gt;";
          case '"':
            return "&quot;";
          case "'":
            return "&#039;";
          default:
            return character;
        }
      });

    const getVerdict = (value) => {
      if (value === "yes") {
        return {
          label: "ساختنیه",
          className: "verdict-yes",
        };
      }

      if (value === "no") {
        return {
          label: "نمی‌ارزه",
          className: "verdict-no",
        };
      }

      return {
        label: "ساختنیه، ولی...",
        className: "verdict-kinda",
      };
    };

    const getToolScore = (tool, query) => {
      const fa = normalize(tool.fa);
      const en = normalize(tool.en);
      const slug = normalize(tool.slug);
      const category = normalize(tool.category);
      const tags = (tool.tags || []).map(normalize);
      const summary = normalize(tool.summary);

      const queryTokens = query.split(" ").filter(Boolean);

      const completeSearchText = [
        fa,
        en,
        slug,
        category,
        ...tags,
        query.length >= 3 ? summary : "",
      ].join(" ");

      const everyTokenMatches = queryTokens.every((token) =>
        completeSearchText.includes(token)
      );

      if (!everyTokenMatches) {
        return -1;
      }

      let score = 0;

      if (fa === query || en === query || slug === query) {
        score += 1000;
      }

      if (
        fa.startsWith(query) ||
        en.startsWith(query) ||
        slug.startsWith(query)
      ) {
        score += 800;
      }

      if (
        fa.includes(query) ||
        en.includes(query) ||
        slug.includes(query)
      ) {
        score += 600;
      }

      if (tags.some((tag) => tag === query)) {
        score += 450;
      } else if (tags.some((tag) => tag.includes(query))) {
        score += 300;
      }

      if (category.includes(query)) {
        score += 180;
      }

      if (query.length >= 3 && summary.includes(query)) {
        score += 80;
      }

      return score;
    };

    const closeResults = () => {
      visibleMatches = [];
      activeIndex = -1;
      results.innerHTML = "";
      results.classList.add("is-hidden");
      searchBox.setAttribute("aria-expanded", "false");
    };

    const updateActiveResult = () => {
      const rows = [
        ...results.querySelectorAll(".sak-search__result"),
      ];

      rows.forEach((row, index) => {
        row.classList.toggle(
          "is-active",
          index === activeIndex
        );
      });

      if (activeIndex >= 0 && rows[activeIndex]) {
        rows[activeIndex].scrollIntoView({
          block: "nearest",
        });
      }
    };

    const renderResults = (matches) => {
      visibleMatches = matches;
      activeIndex = -1;

      if (matches.length === 0) {
        results.innerHTML = `
          <div class="sak-search__empty">
            ابزاری با این نام پیدا نشد.
          </div>
        `;

        results.classList.remove("is-hidden");
        searchBox.setAttribute("aria-expanded", "true");
        return;
      }

      results.innerHTML = matches
        .map((tool, index) => {
          const verdict = getVerdict(tool.verdict);
          const icon =
            String(tool.en || tool.fa)
              .trim()
              .charAt(0)
              .toUpperCase() || "؟";

          return `
            <a
              class="sak-search__result"
              href="/tools/${encodeURIComponent(tool.slug)}"
              role="option"
              data-result-index="${index}"
            >
              <div class="sak-search__result-main">
                <span
                  class="sak-search__icon"
                  aria-hidden="true"
                  dir="ltr"
                >
                  ${escapeHtml(icon)}
                </span>

                <div class="sak-search__copy">
                  <div class="sak-search__name-row">
                    <strong>
                      ${escapeHtml(tool.fa)}
                    </strong>

                    <span
                      class="sak-search__english-name"
                      dir="ltr"
                    >
                      ${escapeHtml(tool.en)}
                    </span>
                  </div>

                  <p>
                    ${escapeHtml(tool.summary)}
                  </p>

                  <div class="sak-search__secondary-meta">
                    <span dir="ltr">
                      ${escapeHtml(tool.domain)}
                    </span>

                    <span>
                      سطح ${escapeHtml(tool.skillLevel)}
                    </span>
                  </div>
                </div>
              </div>

              <div class="sak-search__result-side">
                <span class="sak-search__category">
                  ${escapeHtml(tool.category)}
                </span>

                <span
                  class="sak-search__verdict ${verdict.className}"
                >
                  ${verdict.label}
                </span>

                <div class="sak-search__stats">
                  <span>
                    زمان:
                    <strong>
                      ${escapeHtml(tool.timeEstimate)}
                    </strong>
                  </span>

                  <span>
                    پیچیدگی:
                    <strong dir="ltr">
                      ${escapeHtml(tool.complexity)}/5
                    </strong>
                  </span>
                </div>
              </div>
            </a>
          `;
        })
        .join("");

      results.classList.remove("is-hidden");
      searchBox.setAttribute("aria-expanded", "true");

      results
        .querySelectorAll(".sak-search__result")
        .forEach((row) => {
          row.addEventListener("mouseenter", () => {
            activeIndex = Number(
              row.dataset.resultIndex
            );

            updateActiveResult();
          });
        });
    };

    const runSearch = () => {
      const query = normalize(input.value);

      clearButton.classList.toggle(
        "is-hidden",
        query.length === 0
      );

      shortcut.classList.toggle(
        "is-hidden",
        query.length > 0
      );

      if (query.length < 2) {
        closeResults();
        return;
      }

      const rankedMatches = tools
        .map((tool) => ({
          tool,
          score: getToolScore(tool, query),
        }))
        .filter((entry) => entry.score >= 0)
        .sort((first, second) => {
          if (second.score !== first.score) {
            return second.score - first.score;
          }

          return String(first.tool.fa).localeCompare(
            String(second.tool.fa),
            "fa"
          );
        })
        .slice(0, 6)
        .map((entry) => entry.tool);

      renderResults(rankedMatches);
    };

    input.addEventListener("input", runSearch);

    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        input.value = "";
        closeResults();
        clearButton.classList.add("is-hidden");
        shortcut.classList.remove("is-hidden");
        input.blur();
        return;
      }

      if (visibleMatches.length === 0) {
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();

        activeIndex =
          activeIndex < visibleMatches.length - 1
            ? activeIndex + 1
            : 0;

        updateActiveResult();
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();

        activeIndex =
          activeIndex > 0
            ? activeIndex - 1
            : visibleMatches.length - 1;

        updateActiveResult();
      }

      if (event.key === "Enter") {
        event.preventDefault();

        const selectedIndex =
          activeIndex >= 0 ? activeIndex : 0;

        const selectedTool =
          visibleMatches[selectedIndex];

        if (selectedTool) {
          window.location.href =
            `/tools/${selectedTool.slug}`;
        }
      }
    });

    clearButton.addEventListener("click", () => {
      input.value = "";
      closeResults();
      clearButton.classList.add("is-hidden");
      shortcut.classList.remove("is-hidden");
      input.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLocaleLowerCase() === "k"
      ) {
        event.preventDefault();
        input.focus();
        input.select();
      }
    });

    document.addEventListener("click", (event) => {
      if (!root.contains(event.target)) {
        closeResults();
      }
    });
  }
</script>

<style is:global>
  .sak-search {
    position: relative;
    width: min(900px, 100%);
    margin: 0 auto var(--space-6, 32px);
    direction: rtl;
    text-align: right;
  }

  .sak-search__box {
    min-height: 60px;
    display: grid;
    grid-template-columns:
      auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    direction: rtl;
    background: #0e120f;
    border: 1px solid #263128;
    border-radius: 14px;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .sak-search__box:focus-within {
    border-color: #22e863;
    box-shadow:
      0 0 0 3px rgba(34, 232, 99, 0.09);
  }

  .sak-search__prompt {
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
    font-size: 20px;
    line-height: 1;
  }

  .sak-search__input {
    width: 100% !important;
    min-width: 0;
    height: 58px;
    padding: 0 !important;
    margin: 0;
    direction: rtl !important;
    text-align: right !important;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    color: #f4f4f5 !important;
    font-family: "Vazirmatn", sans-serif;
    font-size: 15px;
  }

  .sak-search__input::placeholder {
    color: #737b74;
    text-align: right;
  }

  .sak-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .sak-search__shortcut {
    min-width: 39px;
    padding: 4px 7px;
    direction: ltr;
    border: 1px solid #29322b;
    border-radius: 6px;
    background: #121713;
    color: #747d76;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    text-align: center;
  }

  .sak-search__clear {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #8f9991;
    font-size: 21px;
    cursor: pointer;
  }

  .sak-search__clear:hover {
    background: #182019;
    color: #ffffff;
  }

  .sak-search__results {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    left: 0;
    z-index: 1000;
    width: 100%;
    max-height: 520px;
    padding: 6px;
    overflow-y: auto;
    background: #0e120f;
    border: 1px solid #263128;
    border-radius: 14px;
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.55);
    direction: rtl;
  }

  .sak-search__result {
    min-height: 118px;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) 225px;
    align-items: center;
    gap: 28px;
    padding: 15px 17px;
    direction: rtl;
    color: #f4f4f5;
    border-radius: 10px;
    text-decoration: none;
    transition: background 130ms ease;
  }

  .sak-search__result + .sak-search__result {
    border-top: 1px solid #202821;
  }

  .sak-search__result:hover,
  .sak-search__result.is-active {
    background: #151b16;
  }

  .sak-search__result-main {
    min-width: 0;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: start;
    gap: 13px;
    direction: rtl;
  }

  .sak-search__icon {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #182019;
    border: 1px solid #2b392e;
    border-radius: 10px;
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
    font-size: 17px;
    font-weight: 700;
  }

  .sak-search__copy {
    min-width: 0;
    direction: rtl;
    text-align: right;
  }

  .sak-search__name-row {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 7px;
    direction: rtl;
  }

  .sak-search__name-row strong {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
  }

  .sak-search__english-name {
    color: #838e86;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
  }

  .sak-search__copy p {
    max-width: 560px;
    margin: 0;
    overflow: hidden;
    color: #9ca59e;
    font-size: 13px;
    line-height: 1.85;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sak-search__secondary-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
    color: #717b73;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .sak-search__result-side {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    direction: rtl;
  }

  .sak-search__category,
  .sak-search__verdict {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 9px;
    border-radius: 7px;
    font-size: 11px;
    white-space: nowrap;
  }

  .sak-search__category {
    color: #a0aaa2;
    background: #131814;
    border: 1px solid #29322b;
  }

  .sak-search__verdict {
    font-weight: 700;
  }

  .sak-search__verdict.verdict-yes {
    color: #22e863;
    border: 1px solid rgba(34, 232, 99, 0.35);
    background: rgba(34, 232, 99, 0.09);
  }

  .sak-search__verdict.verdict-kinda {
    color: #f1c644;
    border: 1px solid rgba(241, 198, 68, 0.35);
    background: rgba(241, 198, 68, 0.09);
  }

  .sak-search__verdict.verdict-no {
    color: #ff6464;
    border: 1px solid rgba(255, 100, 100, 0.35);
    background: rgba(255, 100, 100, 0.09);
  }

  .sak-search__stats {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    color: #7f8981;
    font-size: 10px;
  }

  .sak-search__stats strong {
    color: #c4cbc5;
    font-weight: 500;
  }

  .sak-search__empty {
    padding: 26px 18px;
    color: #8f9991;
    text-align: center;
  }

  .sak-search .is-hidden {
    display: none !important;
  }

  @media (max-width: 720px) {
    .sak-search__box {
      min-height: 56px;
      padding: 0 14px;
    }

    .sak-search__input {
      height: 54px;
      font-size: 14px;
    }

    .sak-search__shortcut {
      display: none;
    }

    .sak-search__results {
      max-height: 430px;
    }

    .sak-search__result {
      grid-template-columns: 1fr;
      gap: 13px;
      min-height: auto;
      padding: 15px;
    }

    .sak-search__copy p {
      white-space: normal;
    }

    .sak-search__result-side {
      align-items: flex-start;
    }

    .sak-search__stats {
      justify-content: flex-start;
    }
  }
</style>
