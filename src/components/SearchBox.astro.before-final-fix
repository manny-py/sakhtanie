---
import { apps } from "../lib/apps";

const categoryLabels: Record<string, string> = {
  "ai-assistants": "دستیارهای هوش مصنوعی",
  productivity: "بهره‌وری",
  "website-commerce": "وب و کسب‌وکار",
  "development-automation": "توسعه و اتوماسیون",
};

const searchableTools = apps.map((app) => ({
  slug: app.slug,
  fa: app.name.fa,
  en: app.name.en,
  summary: app.summary,
  category: categoryLabels[app.category] ?? app.category,
  verdict: app.verdict.value,
}));
---

<div
  class="search-shell"
  data-tool-search
  data-tools={JSON.stringify(searchableTools)}
>
  <div
    class="search-box"
    role="combobox"
    aria-expanded="false"
    aria-controls="tool-search-results"
  >
    <span class="prompt" aria-hidden="true">&gt;</span>

    <input
      id="tool-search"
      type="search"
      placeholder="اسم ابزار را جست‌وجو کن..."
      autocomplete="off"
      spellcheck="false"
      dir="auto"
      aria-label="جست‌وجوی ابزار"
    />

    <button
      class="clear-button is-hidden"
      type="button"
      aria-label="پاک‌کردن جست‌وجو"
    >
      ×
    </button>

    <kbd class="shortcut">⌘ K</kbd>
  </div>

  <div
    id="tool-search-results"
    class="results is-hidden"
    role="listbox"
    aria-label="نتایج جست‌وجو"
  ></div>
</div>

<script>
  const root = document.querySelector("[data-tool-search]");

  if (root instanceof HTMLElement) {
    const input = root.querySelector("#tool-search");
    const results = root.querySelector("#tool-search-results");
    const searchBox = root.querySelector(".search-box");
    const clearButton = root.querySelector(".clear-button");
    const shortcut = root.querySelector(".shortcut");

    let tools = [];
    let visibleMatches = [];
    let activeIndex = -1;

    try {
      tools = JSON.parse(root.dataset.tools || "[]");
    } catch {
      tools = [];
    }

    const normalize = (value) =>
      String(value)
        .toLocaleLowerCase("fa")
        .replace(/\u200c/g, " ")
        .replace(/\s+/g, " ")
        .trim();

    const escapeHtml = (value) =>
      String(value).replace(/[&<>"']/g, (character) => {
        const entities = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        };

        return entities[character];
      });

    const verdictData = {
      yes: {
        label: "ساختنیه",
        className: "verdict-yes",
      },
      kinda: {
        label: "ساختنیه، ولی...",
        className: "verdict-kinda",
      },
      no: {
        label: "نمی‌ارزه",
        className: "verdict-no",
      },
    };

    const closeResults = () => {
      visibleMatches = [];
      activeIndex = -1;
      results.innerHTML = "";
      results.classList.add("is-hidden");
      searchBox.setAttribute("aria-expanded", "false");
    };

    const updateActiveResult = () => {
      const rows = [...results.querySelectorAll(".result-row")];

      rows.forEach((row, index) => {
        row.classList.toggle("is-active", index === activeIndex);
      });

      if (activeIndex >= 0 && rows[activeIndex]) {
        rows[activeIndex].scrollIntoView({
          block: "nearest",
        });
      }
    };

    const renderResults = (matches) => {
      visibleMatches = matches;
      activeIndex = -1;

      if (matches.length === 0) {
        results.innerHTML = `
          <div class="empty-result">
            ابزاری با این نام پیدا نشد.
          </div>
        `;

        results.classList.remove("is-hidden");
        searchBox.setAttribute("aria-expanded", "true");
        return;
      }

      results.innerHTML = matches
        .map((tool, index) => {
          const verdict =
            verdictData[tool.verdict] ?? verdictData.kinda;

          return `
            <a
              class="result-row"
              href="/tools/${encodeURIComponent(tool.slug)}"
              role="option"
              data-result-index="${index}"
            >
              <div class="result-copy">
                <div class="result-heading">
                  <strong>${escapeHtml(tool.fa)}</strong>
                  <span class="english-name" dir="ltr">
                    ${escapeHtml(tool.en)}
                  </span>
                </div>

                <p>${escapeHtml(tool.summary)}</p>
              </div>

              <div class="result-meta">
                <span class="category-badge">
                  ${escapeHtml(tool.category)}
                </span>

                <span class="verdict-badge ${verdict.className}">
                  ${verdict.label}
                </span>
              </div>
            </a>
          `;
        })
        .join("");

      results.classList.remove("is-hidden");
      searchBox.setAttribute("aria-expanded", "true");

      results
        .querySelectorAll(".result-row")
        .forEach((row) => {
          row.addEventListener("mouseenter", () => {
            activeIndex = Number(row.dataset.resultIndex);
            updateActiveResult();
          });
        });
    };

    const runSearch = () => {
      const query = normalize(input.value);

      clearButton.classList.toggle(
        "is-hidden",
        query.length === 0
      );

      shortcut.classList.toggle(
        "is-hidden",
        query.length > 0
      );

      if (!query) {
        closeResults();
        return;
      }

      const matches = tools
        .filter((tool) => {
          const searchableText = normalize(
            [
              tool.fa,
              tool.en,
              tool.summary,
              tool.category,
            ].join(" ")
          );

          return searchableText.includes(query);
        })
        .slice(0, 6);

      renderResults(matches);
    };

    input.addEventListener("input", runSearch);

    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        input.value = "";
        closeResults();
        clearButton.classList.add("is-hidden");
        shortcut.classList.remove("is-hidden");
        input.blur();
        return;
      }

      if (visibleMatches.length === 0) {
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();

        activeIndex =
          activeIndex < visibleMatches.length - 1
            ? activeIndex + 1
            : 0;

        updateActiveResult();
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();

        activeIndex =
          activeIndex > 0
            ? activeIndex - 1
            : visibleMatches.length - 1;

        updateActiveResult();
      }

      if (event.key === "Enter") {
        event.preventDefault();

        const selectedIndex =
          activeIndex >= 0 ? activeIndex : 0;

        const selectedTool =
          visibleMatches[selectedIndex];

        if (selectedTool) {
          window.location.href =
            `/tools/${selectedTool.slug}`;
        }
      }
    });

    clearButton.addEventListener("click", () => {
      input.value = "";
      closeResults();
      clearButton.classList.add("is-hidden");
      shortcut.classList.remove("is-hidden");
      input.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLocaleLowerCase() === "k"
      ) {
        event.preventDefault();
        input.focus();
        input.select();
      }
    });

    document.addEventListener("click", (event) => {
      if (!root.contains(event.target)) {
        closeResults();
      }
    });
  }
</script>

<style>
  .search-shell {
    width: min(900px, 100%);
    margin: 0 auto var(--space-6, 32px);
    direction: rtl;
  }

  .search-box {
    min-height: 60px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    background: #0e120f;
    border: 1px solid #263128;
    border-radius: 14px;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .search-box:focus-within {
    border-color: #22e863;
    box-shadow: 0 0 0 3px rgba(34, 232, 99, 0.09);
  }

  .prompt {
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
    font-size: 20px;
    line-height: 1;
  }

  #tool-search {
    width: 100%;
    min-width: 0;
    height: 58px;
    padding: 0;
    margin: 0;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0;
    outline: 0;
    box-shadow: none !important;
    color: #f4f4f5;
    font-family: "Vazirmatn", sans-serif;
    font-size: 15px;
    text-align: right;
  }

  #tool-search::placeholder {
    color: #737b74;
  }

  #tool-search::-webkit-search-cancel-button {
    display: none;
  }

  .shortcut {
    min-width: 39px;
    padding: 4px 7px;
    border: 1px solid #29322b;
    border-radius: 6px;
    background: #121713;
    color: #747d76;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    direction: ltr;
    text-align: center;
  }

  .clear-button {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #8f9991;
    font-size: 21px;
    cursor: pointer;
  }

  .clear-button:hover {
    background: #182019;
    color: #ffffff;
  }

  .results {
    position: relative;
    width: 100%;
    margin-top: 10px;
    padding: 6px;
    overflow: hidden;
    background: #0e120f;
    border: 1px solid #263128;
    border-radius: 14px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.32);
  }

  .result-row {
    min-height: 86px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: 14px 16px;
    color: #f4f4f5;
    border-radius: 10px;
    text-decoration: none;
    transition: background 130ms ease;
  }

  .result-row + .result-row {
    border-top: 1px solid #202821;
  }

  .result-row:hover,
  .result-row.is-active {
    background: #151b16;
  }

  .result-copy {
    min-width: 0;
    text-align: right;
  }

  .result-heading {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 7px;
  }

  .result-heading strong {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
  }

  .english-name {
    color: #7f8981;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
  }

  .result-copy p {
    max-width: 620px;
    margin: 0;
    overflow: hidden;
    color: #969f98;
    font-size: 13px;
    line-height: 1.8;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    direction: rtl;
  }

  .category-badge,
  .verdict-badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 9px;
    border: 1px solid #29322b;
    border-radius: 7px;
    font-size: 11px;
    white-space: nowrap;
  }

  .category-badge {
    color: #a0aaa2;
    background: #131814;
  }

  .verdict-badge {
    font-weight: 700;
  }

  .verdict-yes {
    color: #22e863;
    border-color: rgba(34, 232, 99, 0.35);
    background: rgba(34, 232, 99, 0.09);
  }

  .verdict-kinda {
    color: #f1c644;
    border-color: rgba(241, 198, 68, 0.35);
    background: rgba(241, 198, 68, 0.09);
  }

  .verdict-no {
    color: #ff6464;
    border-color: rgba(255, 100, 100, 0.35);
    background: rgba(255, 100, 100, 0.09);
  }

  .empty-result {
    padding: 24px 18px;
    color: #8f9991;
    text-align: center;
  }

  .is-hidden {
    display: none !important;
  }

  @media (max-width: 680px) {
    .search-box {
      min-height: 56px;
      padding: 0 14px;
    }

    #tool-search {
      height: 54px;
      font-size: 14px;
    }

    .shortcut {
      display: none;
    }

    .result-row {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 14px;
    }

    .result-copy p {
      white-space: normal;
    }

    .result-meta {
      justify-content: flex-start;
    }
  }
</style>
