---
import {
  sponsorSchema,
  type Sponsor,
} from "../lib/sponsors";
import { MONETIZATION_ENABLED } from "../lib/monetization";
import SponsorSlotClient from "./SponsorSlotClient.astro";

interface Props {
  sponsor: Sponsor;
  variant?: "primary" | "secondary";
}

const {
  sponsor: sponsorDefinition,
  variant = "primary",
} = Astro.props;

const sponsor = sponsorSchema.parse(sponsorDefinition);
const headingId = `sponsor-${sponsor.id}-title`;
const ctaLabel = sponsor.ctaLabel ?? "مشاهده وب‌سایت";
const logoAlt = sponsor.logoAlt ?? "";
---

{
  MONETIZATION_ENABLED && (
<Fragment>
<section
  class:list={[
    "sponsor-slot",
    `sponsor-slot--${variant}`,
  ]}
  aria-labelledby={headingId}
  data-sponsor-slot
  data-sponsor-id={sponsor.id}
  data-sponsor-active={String(sponsor.active)}
>
  {
    sponsor.active ? (
      <a
        class="sponsor-content"
        href={sponsor.href}
        target="_blank"
        rel="sponsored noopener noreferrer"
        aria-label={`محتوای حمایت‌شده از ${sponsor.brand}: ${sponsor.title}`}
        data-sponsor-link
      >
        <div class="sponsor-main">
          {sponsor.logoSrc ? (
            <span class="sponsor-logo-frame">
              <img
                src={sponsor.logoSrc}
                alt={logoAlt}
                width="72"
                height="72"
                loading="lazy"
                decoding="async"
              />
            </span>
          ) : null}

          <div class="sponsor-copy">
            <div class="sponsor-meta">
              <span class="sponsor-label">
                SPONSORED
              </span>

              <span class="sponsor-brand">
                {sponsor.brand}
              </span>
            </div>

            <h2 id={headingId}>{sponsor.title}</h2>
            <p>{sponsor.description}</p>
          </div>
        </div>

        <span class="sponsor-action">
          {ctaLabel}
          <span aria-hidden="true" dir="ltr">↗</span>
        </span>
      </a>
    ) : (
      <div class="sponsor-empty">
        <div>
          <span class="sponsor-label sponsor-label--empty">
            SPONSORSHIP
          </span>

          <h2 id={headingId}>
            این جایگاه می‌تواند برای برند شما باشد
          </h2>

          <p>
            معرفی محصول، سرویس یا ابزار شما به مخاطبانی که
            برای ساخت و انتخاب محصولات دیجیتال به ساختنیه؟
            سر می‌زنند.
          </p>
        </div>

        <a
          href="/advertise"
          class="sponsor-action"
          data-advertise-cta
        >
          تبلیغ در ساختنیه؟
          <span aria-hidden="true">←</span>
        </a>
      </div>
    )
  }
</section>
<SponsorSlotClient />
</Fragment>
  )
}

<style>
  .sponsor-slot {
    max-width: 900px;
    margin: 28px auto;
    border: 1px solid rgba(241, 198, 68, 0.28);
    border-radius: 14px;
    background:
      linear-gradient(
        135deg,
        rgba(241, 198, 68, 0.07),
        rgba(34, 232, 99, 0.025)
      ),
      #0d110e;
    overflow: hidden;
  }

  .sponsor-slot--secondary {
    margin-top: 44px;
    margin-bottom: 44px;
  }

  .sponsor-content,
  .sponsor-empty {
    min-height: 150px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 24px;
  }

  .sponsor-content:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .sponsor-content:focus-visible,
  .sponsor-action:focus-visible {
    outline: 3px solid rgba(34, 232, 99, 0.38);
    outline-offset: -3px;
  }

  .sponsor-main {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .sponsor-logo-frame {
    width: 72px;
    height: 72px;
    flex: 0 0 72px;
    display: grid;
    place-items: center;
    padding: 10px;
    border: 1px solid rgba(241, 198, 68, 0.18);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.035);
  }

  .sponsor-logo-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .sponsor-copy,
  .sponsor-empty > div {
    min-width: 0;
    max-width: 650px;
  }

  .sponsor-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .sponsor-label {
    display: inline-flex;
    padding: 4px 7px;
    border: 1px solid rgba(241, 198, 68, 0.26);
    border-radius: 999px;
    background: rgba(241, 198, 68, 0.07);
    color: #f1c644;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .sponsor-label--empty {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .sponsor-brand {
    color: #89938b;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    overflow-wrap: anywhere;
  }

  h2 {
    margin: 9px 0 8px;
    color: #f4f4f5;
    font-size: 20px;
  }

  p {
    max-width: 650px;
    margin: 0;
    color: #8d978f;
    font-size: 12px;
    line-height: 2;
  }

  .sponsor-action {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 13px;
    border: 1px solid rgba(241, 198, 68, 0.3);
    border-radius: 8px;
    color: #f1c644;
    font-family: "JetBrains Mono", "Vazirmatn", monospace;
    font-size: 10px;
    white-space: nowrap;
  }

  @media (max-width: 650px) {
    .sponsor-content,
    .sponsor-empty {
      min-height: 0;
      align-items: stretch;
      flex-direction: column;
      gap: 20px;
      padding: 19px;
    }

    .sponsor-main {
      align-items: flex-start;
      gap: 14px;
    }

    .sponsor-logo-frame {
      width: 58px;
      height: 58px;
      flex-basis: 58px;
      padding: 8px;
    }

    .sponsor-action {
      align-self: flex-start;
      white-space: normal;
    }

    h2 {
      font-size: 18px;
    }
  }
</style>
