<section class="analytics-dashboard-runtime" data-analytics-dashboard>
  <section class="analytics-grid">
    <div class="card analytics-card">
      <strong data-total-views>0</strong>
      <span class="muted">بازدید کل</span>
    </div>

    <div class="card analytics-card">
      <strong data-tool-views>0</strong>
      <span class="muted">مشاهده ابزارها</span>
    </div>

    <div class="card analytics-card">
      <strong data-searches>0</strong>
      <span class="muted">جست‌وجوها</span>
    </div>

    <div class="card analytics-card">
      <strong data-tool-cta-clicks>0</strong>
      <span class="muted">کلیک CTA ابزارها</span>
    </div>
  </section>

  <section class="card analytics-chart-section">
    <div class="section-heading">
      <h2>نمودار بازدید</h2>
      <p class="muted">بازدید واقعی ۷ روز اخیر</p>
    </div>

    <div class="chart-wrap">
      <svg
        viewBox="0 0 600 220"
        role="img"
        aria-label="نمودار بازدید هفت روز اخیر"
        data-chart
      >
        <polyline
          data-chart-line
          points=""
          fill="none"
          stroke="var(--primary)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></polyline>

        <g data-chart-points></g>
      </svg>

      <div class="chart-labels" data-chart-labels></div>
    </div>

    <p class="muted chart-status" data-dashboard-status>
      در حال دریافت داده...
    </p>
  </section>

  <section class="analytics-detail-grid">
    <div class="card analytics-detail-card">
      <div class="section-heading">
        <h2>ابزارهای پربازدید</h2>
        <p class="muted">بر اساس Tool View در ۷ روز اخیر</p>
      </div>

      <div class="analytics-list" data-popular-tools>
        <p class="muted">در حال دریافت داده...</p>
      </div>
    </div>
  </section>
</section>

<script>
  import {
    ANALYTICS_ORIGIN,
    isSafeAnalyticsIdentifier,
  } from "../lib/analytics";

  interface DashboardPoint {
    date: string;
    views: number;
  }

  interface PopularTool {
    slug: string;
    views: number;
  }

  interface DashboardResponse {
    success: true;
    range_days: number;
    summary: {
      totalViews: number;
      toolViews: number;
      searches: number;
      toolCtaClicks: number;
    };
    viewsOverTime: DashboardPoint[];
    popularTools: PopularTool[];
  }

  const isSafeAggregateCount = (value: unknown): value is number =>
    typeof value === "number" &&
    Number.isSafeInteger(value) &&
    value >= 0;

  const parseDashboardResponse = (
    value: unknown
  ): DashboardResponse | null => {
    if (typeof value !== "object" || value === null) {
      return null;
    }

    const candidate = value as Record<string, unknown>;
    const summary = candidate.summary;

    if (
      candidate.success !== true ||
      !Number.isInteger(candidate.range_days) ||
      (candidate.range_days as number) < 1 ||
      (candidate.range_days as number) > 31 ||
      typeof summary !== "object" ||
      summary === null ||
      !Array.isArray(candidate.viewsOverTime) ||
      !Array.isArray(candidate.popularTools)
    ) {
      return null;
    }

    const aggregateSummary = summary as Record<string, unknown>;

    if (
      !isSafeAggregateCount(aggregateSummary.totalViews) ||
      !isSafeAggregateCount(aggregateSummary.toolViews) ||
      !isSafeAggregateCount(aggregateSummary.searches) ||
      !isSafeAggregateCount(aggregateSummary.toolCtaClicks)
    ) {
      return null;
    }

    const viewsOverTime = candidate.viewsOverTime
      .filter((item): item is Record<string, unknown> =>
        typeof item === "object" && item !== null
      )
      .filter(
        (item) =>
          typeof item.date === "string" &&
          /^\d{4}-\d{2}-\d{2}$/.test(item.date) &&
          isSafeAggregateCount(item.views)
      )
      .slice(-31)
      .map((item) => ({
        date: item.date as string,
        views: item.views as number,
      }));

    const popularTools = candidate.popularTools
      .filter((item): item is Record<string, unknown> =>
        typeof item === "object" && item !== null
      )
      .filter(
        (item) =>
          isSafeAnalyticsIdentifier(item.slug) &&
          isSafeAggregateCount(item.views)
      )
      .slice(0, 20)
      .map((item) => ({
        slug: item.slug as string,
        views: item.views as number,
      }));

    return {
      success: true,
      range_days: candidate.range_days as number,
      summary: {
        totalViews: aggregateSummary.totalViews,
        toolViews: aggregateSummary.toolViews,
        searches: aggregateSummary.searches,
        toolCtaClicks: aggregateSummary.toolCtaClicks,
      },
      viewsOverTime,
      popularTools,
    };
  };

  const ENDPOINT = `${ANALYTICS_ORIGIN}/v1/dashboard?days=7`;

  const root = document.querySelector<HTMLElement>(
    "[data-analytics-dashboard]"
  );

  if (root) {
    const totalViews =
      root.querySelector<HTMLElement>("[data-total-views]");

    const toolViews =
      root.querySelector<HTMLElement>("[data-tool-views]");

    const searches =
      root.querySelector<HTMLElement>("[data-searches]");

    const toolCtaClicks =
      root.querySelector<HTMLElement>("[data-tool-cta-clicks]");

    const line =
      root.querySelector<SVGPolylineElement>("[data-chart-line]");

    const pointsGroup =
      root.querySelector<SVGGElement>("[data-chart-points]");

    const labels =
      root.querySelector<HTMLElement>("[data-chart-labels]");

    const status =
      root.querySelector<HTMLElement>("[data-dashboard-status]");

    const popularTools =
      root.querySelector<HTMLElement>("[data-popular-tools]");

    const renderChart = (data: DashboardPoint[]) => {
      if (!line || !pointsGroup || !labels) return;

      const max = Math.max(...data.map((item) => item.views), 1);

      const coords = data.map((item, index) => {
        const x =
          data.length === 1
            ? 300
            : 30 + (index / (data.length - 1)) * 540;

        const y = 180 - (item.views / max) * 140;

        return { x, y, item };
      });

      line.setAttribute(
        "points",
        coords.map((point) => `${point.x},${point.y}`).join(" ")
      );

      pointsGroup.replaceChildren();

      for (const point of coords) {
        const circle = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "circle"
        );

        circle.setAttribute("cx", String(point.x));
        circle.setAttribute("cy", String(point.y));
        circle.setAttribute("r", "5");
        circle.setAttribute("fill", "var(--primary)");

        pointsGroup.appendChild(circle);
      }

      labels.replaceChildren();

      for (const point of coords) {
        const label = document.createElement("span");
        label.textContent =
          `${point.item.date.slice(5)} · ${point.item.views}`;
        labels.appendChild(label);
      }
    };

    const renderPopularTools = (tools: PopularTool[]) => {
      if (!popularTools) return;

      popularTools.replaceChildren();

      if (tools.length === 0) {
        const empty = document.createElement("p");
        empty.className = "muted";
        empty.textContent = "هنوز داده‌ای ثبت نشده است.";
        popularTools.appendChild(empty);
        return;
      }

      tools.forEach((tool, index) => {
          const row = document.createElement("a");
          row.className = "analytics-list-row";
          row.href = `/tools/${encodeURIComponent(tool.slug)}`;

          const name = document.createElement("span");
          name.textContent = `${index + 1}. ${tool.slug}`;

          const value = document.createElement("strong");
          value.textContent = String(tool.views);

          row.append(name, value);
          popularTools.appendChild(row);
        });
    };

    const loadDashboard = async () => {
      try {
        const response = await fetch(ENDPOINT, {
          headers: {
            Accept: "application/json",
          },
          cache: "no-store",
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const data = parseDashboardResponse(await response.json());

        if (!data) {
          throw new Error("Dashboard API failure");
        }

        if (totalViews) {
          totalViews.textContent = String(data.summary.totalViews);
        }

        if (toolViews) {
          toolViews.textContent = String(data.summary.toolViews);
        }

        if (searches) {
          searches.textContent = String(data.summary.searches);
        }

        if (toolCtaClicks) {
          toolCtaClicks.textContent =
            String(data.summary.toolCtaClicks);
        }

        renderChart(data.viewsOverTime);
        renderPopularTools(data.popularTools);

        if (status) {
          status.textContent =
            `داده تجمیعی · بازه ${data.range_days} روزه`;
        }
      } catch {
        if (status) {
          status.textContent =
            "دریافت داده‌های داشبورد موقتاً ممکن نیست.";
        }
      }
    };

    loadDashboard();

    const timer = window.setInterval(loadDashboard, 30_000);

    window.addEventListener(
      "pagehide",
      () => window.clearInterval(timer),
      { once: true }
    );
  }
</script>

<style>
  .analytics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .analytics-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .analytics-card strong {
    font-size: 2rem;
    color: var(--primary);
    font-family: "JetBrains Mono", monospace;
  }

  .analytics-chart-section {
    margin-top: 24px;
  }

  .section-heading {
    margin-bottom: 20px;
  }

  .section-heading h2 {
    margin: 0 0 6px;
  }

  .chart-wrap {
    overflow-x: auto;
  }

  .chart-wrap svg {
    width: 100%;
    min-width: 560px;
    height: 220px;
    display: block;
  }

  .chart-labels {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    min-width: 560px;
    font-family: monospace;
    font-size: 0.72rem;
    opacity: 0.7;
    text-align: center;
  }

  .chart-status {
    margin-top: 14px;
    font-size: 0.8rem;
  }

  .analytics-detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 24px;
  }

  .analytics-list {
    display: grid;
    gap: 8px;
  }

  :global(.analytics-list-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
  }

  :global(.analytics-list-row strong) {
    color: var(--primary);
    font-family: "JetBrains Mono", monospace;
  }

  @media (max-width: 1000px) {
    .analytics-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 560px) {
    .analytics-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
