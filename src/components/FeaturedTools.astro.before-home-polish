---
import { apps } from "../lib/apps";
const featured = apps.slice(0,6);
---

<section>

<h2>
ابزارهای منتخب
</h2>

<div>

{
featured.map((app:any)=>(
<a class="card" href={`/tools/${app.slug}`} style="display:block;margin-bottom:12px">

<strong>
{app.name.fa}
</strong>

<p>
{app.summary}
</p>

</a>
))
}

</div>

</section>
