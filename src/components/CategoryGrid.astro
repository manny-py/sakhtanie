---
import { apps } from "../lib/apps";

const categoryDefinitions = [
  {
    slug: "ai-assistants",
    title: "دستیارهای هوش مصنوعی",
    symbol: "AI",
  },
  {
    slug: "productivity",
    title: "بهره‌وری",
    symbol: "PX",
  },
  {
    slug: "development-automation",
    title: "توسعه و اتوماسیون",
    symbol: "DEV",
  },
  {
    slug: "website-commerce",
    title: "وب و کسب‌وکار",
    symbol: "WEB",
  },
];

const categories = categoryDefinitions.map((category) => ({
  ...category,
  count: apps.filter(
    (app) => app.category === category.slug
  ).length,
}));
---

<section id="categories" class="categories-section">
  <div class="section-heading">
    <div>
      <span class="section-kicker">CATEGORIES</span>
      <h2>دسته‌بندی‌ها</h2>
    </div>

    <span class="section-note">
      بر اساس نوع محصول
    </span>
  </div>

  <div class="category-list">
    {
      categories.map((category) => (
        <a
          class="category-chip"
          href={`/categories/${category.slug}`}
        >
          <span class="category-chip__symbol">
            {category.symbol}
          </span>

          <span class="category-chip__title">
            {category.title}
          </span>

          <span class="category-chip__count" dir="ltr">
            {category.count}
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .categories-section {
    max-width: 900px;
    padding: 28px 0 42px;
    margin: 0 auto;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .section-heading h2 {
    margin: 5px 0 0;
    color: #f4f4f5;
    font-size: 23px;
  }

  .section-kicker,
  .section-note {
    color: #6f7971;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .category-chip {
    display: inline-grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 12px 6px 8px;
    border: 1px solid #263028;
    border-radius: 999px;
    background: #0e120f;
    color: #cbd2cc;
    transition:
      border-color 150ms ease,
      background 150ms ease;
  }

  .category-chip:hover {
    border-color: rgba(34, 232, 99, 0.45);
    background: #141a15;
  }

  .category-chip__symbol {
    min-width: 30px;
    padding: 4px 6px;
    border-radius: 999px;
    background: #19211a;
    color: #22e863;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    text-align: center;
  }

  .category-chip__title {
    font-size: 12px;
  }

  .category-chip__count {
    min-width: 24px;
    color: #727c74;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    text-align: center;
  }

  @media (max-width: 620px) {
    .section-heading {
      align-items: flex-start;
    }

    .section-note {
      display: none;
    }

    .category-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .category-chip {
      grid-template-columns: auto minmax(0, 1fr) auto;
      border-radius: 11px;
    }
  }
</style>
