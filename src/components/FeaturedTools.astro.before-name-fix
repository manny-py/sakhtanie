---
import { apps } from "../lib/apps";

const preferredSlugs = [
  "chatgpt",
  "claude",
  "cursor",
  "lovable",
  "bolt",
  "canva",
  "notion",
  "shopify",
];

const categoryLabels: Record<string, string> = {
  "ai-assistants": "هوش مصنوعی",
  productivity: "بهره‌وری",
  "website-commerce": "وب و کسب‌وکار",
  "development-automation": "توسعه",
};

const timeLabels: Record<string, string> = {
  "few-hours": "چند ساعت",
  "one-day": "یک روز",
  "few-days": "چند روز",
  "one-weekend": "یک آخر هفته",
  "one-week": "یک هفته",
  "few-weeks": "چند هفته",
  "one-month": "یک ماه",
  "few-months": "چند ماه",
};

const verdictLabels: Record<string, string> = {
  yes: "ساختنیه",
  kinda: "ساختنیه، ولی...",
  no: "نمی‌ارزه",
};

const featured = preferredSlugs
  .map((slug) => apps.find((app) => app.slug === slug))
  .filter(Boolean);
---

<section class="featured-section">
  <div class="featured-heading">
    <div>
      <span>FEATURED DATABASE</span>
      <h2>ابزارهای منتخب</h2>
    </div>

    <span class="featured-heading__count">
      {featured.length} ابزار
    </span>
  </div>

  <div class="tool-table">
    <div class="tool-table__header">
      <span>ابزار</span>
      <span>دسته</span>
      <span>زمان ساخت</span>
      <span>نتیجه</span>
      <span>پیچیدگی</span>
    </div>

    {
      featured.map((app, index) => (
        <a
          class="tool-row"
          href={`/tools/${app.slug}`}
        >
          <div class="tool-row__main">
            <span class="tool-row__rank" dir="ltr">
              {String(index + 1).padStart(2, "0")}
            </span>

            <div>
              <strong>{app.name.fa}</strong>
              <small dir="ltr">{app.name.en}</small>
            </div>
          </div>

          <span class="tool-row__category">
            {categoryLabels[app.category] ?? app.category}
          </span>

          <span class="tool-row__time">
            {timeLabels[app.build.timeEstimate] ??
              app.build.timeEstimate}
          </span>

          <span
            class:list={[
              "tool-row__verdict",
              `verdict-${app.verdict.value}`,
            ]}
          >
            {verdictLabels[app.verdict.value] ??
              app.verdict.value}
          </span>

          <span class="tool-row__complexity" dir="ltr">
            {app.scores.technicalComplexity}/5
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .featured-section {
    max-width: 900px;
    padding: 20px 0 80px;
    margin: 0 auto;
  }

  .featured-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .featured-heading > div > span,
  .featured-heading__count {
    color: #6f7971;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .featured-heading h2 {
    margin: 5px 0 0;
    color: #f4f4f5;
    font-size: 23px;
  }

  .tool-table {
    overflow: hidden;
    border: 1px solid #202a22;
    border-radius: 14px;
    background: #0d110e;
  }

  .tool-table__header,
  .tool-row {
    display: grid;
    grid-template-columns:
      minmax(240px, 1.8fr)
      minmax(100px, 1fr)
      minmax(90px, 0.8fr)
      minmax(110px, 0.9fr)
      70px;
    align-items: center;
    gap: 18px;
    padding: 0 18px;
  }

  .tool-table__header {
    min-height: 48px;
    color: #727c74;
    border-bottom: 1px solid #202a22;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .tool-row {
    min-height: 72px;
    transition: background 140ms ease;
  }

  .tool-row + .tool-row {
    border-top: 1px solid #1e2720;
  }

  .tool-row:hover {
    background: #141a15;
  }

  .tool-row__main {
    min-width: 0;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    align-items: center;
    gap: 13px;
  }

  .tool-row__rank {
    color: #667068;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .tool-row__main strong {
    display: block;
    overflow: hidden;
    color: #f4f4f5;
    font-size: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-row__main small {
    display: block;
    margin-top: 3px;
    overflow: hidden;
    color: #717b73;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-row__category,
  .tool-row__time {
    color: #99a29b;
    font-size: 11px;
  }

  .tool-row__verdict {
    width: fit-content;
    padding: 5px 8px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  .verdict-yes {
    color: #22e863;
    background: rgba(34, 232, 99, 0.1);
    border: 1px solid rgba(34, 232, 99, 0.3);
  }

  .verdict-kinda {
    color: #f1c644;
    background: rgba(241, 198, 68, 0.1);
    border: 1px solid rgba(241, 198, 68, 0.3);
  }

  .verdict-no {
    color: #ff6464;
    background: rgba(255, 100, 100, 0.1);
    border: 1px solid rgba(255, 100, 100, 0.3);
  }

  .tool-row__complexity {
    color: #9ca59e;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
  }

  @media (max-width: 760px) {
    .tool-table__header {
      display: none;
    }

    .tool-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      padding: 14px;
    }

    .tool-row__category,
    .tool-row__time {
      display: none;
    }

    .tool-row__complexity {
      display: none;
    }

    .tool-row__verdict {
      justify-self: end;
    }
  }
</style>
