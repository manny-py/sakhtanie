---
const { app } = Astro.props;

const englishName = app?.name?.en?.trim() ?? "";
const initials =
  englishName
    .match(/[a-z0-9]+/gi)
    ?.slice(0, 2)
    .map((part) => part.charAt(0))
    .join("")
    .toUpperCase() || "?";
const accessibleLabel = englishName ? `لوگوی ${englishName}` : "لوگوی ابزار";
---

<span class="app-logo" role="img" aria-label={accessibleLabel}>
  <span class="app-logo__fallback" dir="ltr" aria-hidden="true">
    {initials}
  </span>

  <img
    src={app.logo}
    alt={accessibleLabel}
    loading="lazy"
    decoding="async"
    data-app-logo-image
    data-logo-state="pending"
  />
</span>

<script>
  document
    .querySelectorAll<HTMLImageElement>("[data-app-logo-image]")
    .forEach((image) => {
      const showLoadedImage = () => {
        image.dataset.logoState = "loaded";
      };

      const hideBrokenImage = () => {
        image.hidden = true;
        image.dataset.logoState = "missing";
      };

      image.addEventListener("load", showLoadedImage, { once: true });
      image.addEventListener("error", hideBrokenImage, { once: true });

      if (image.complete) {
        if (image.naturalWidth > 0) showLoadedImage();
        else hideBrokenImage();
      }
    });
</script>

<style>
  .app-logo {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #22e863;
    background:
      radial-gradient(circle at 30% 20%, rgba(34, 232, 99, 0.1), transparent 55%),
      #0b100c;
    border: 1px solid rgba(117, 255, 159, 0.18);
    border-radius: inherit;
  }

  .app-logo__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: currentColor;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.9em;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .app-logo img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    opacity: 0;
  }

  .app-logo img[data-logo-state="loaded"] {
    opacity: 1;
  }
</style>
